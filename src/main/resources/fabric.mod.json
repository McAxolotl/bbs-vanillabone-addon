{
	"schemaVersion": 1,
	"id": "bbsvanillabone",
	"version": "${version}",
	"name": "BBS Vanilla Bone Addon",
	"description": "Per-bone posing, colouring and film animation for vanilla Minecraft mobs, right inside BBS mob forms.",
	"authors": [
		"McAxolotl"
	],
	"contact": {
		"homepage": "https://github.com/McAxolotl/bbs-vanillabone-addon",
		"sources": "https://github.com/McAxolotl/bbs-vanillabone-addon",
		"issues": "https://github.com/McAxolotl/bbs-vanillabone-addon/issues"
	},
	"license": "MIT",
	"icon": "assets/bbsvanillabone/icon.png",
	"environment": "*",
	"entrypoints": {
		"bbs-addon": [
			"mcaxolotl.bbsvanillabone.BBSVanillaBoneAddon"
		],
		"bbs-client-addon": [
			"mcaxolotl.bbsvanillabone.client.BBSVanillaBoneClientAddon"
		]
	},
	"mixins": [
		"bbsvanillabone.mixins.json",
		{
			"config": "bbsvanillabone.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.20.4",
		"java": ">=17",
		"fabric-api": "*",
		"bbs": "*"
	}
}
